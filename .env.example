# Exemplo de variáveis locais. Copie para .env (ignorado pelo Git) e preencha.
# Nunca commite valores reais.

# --- Harness do executor (services/execution/korda_execution/harness) ---
# Quem constrói o pipeline: roteirizado (padrão, plano B: copia o pipeline feito à mão, sem LLM),
# falso (testes, sem LLM), chat (agente sobre API chat/completions, ex.: gateway da Feita)
# ou agente_sdk (Claude Agent SDK, exige chave da Anthropic).
KORDA_EXECUTOR=roteirizado
# chat e agente_sdk só rodam com KORDA_PERMITIR_LLM_REAL=1, autorizado pelo responsável pela chave.
KORDA_PERMITIR_LLM_REAL=
# Chave do gateway chat/completions (Feita). Nunca commitar; fica no host, nunca entra na sandbox.
KORDA_LLM_CHAVE=
KORDA_LLM_URL=https://api.feita.ai/gateway/v1
# Chave da Anthropic, só para KORDA_EXECUTOR=agente_sdk.
ANTHROPIC_API_KEY=
# Padrão: anthropic/claude-opus-5.5 (chat) ou claude-opus-5-5 (agente_sdk).
KORDA_MODELO=
# Teto de gasto com LLM por execução (construção + até 3 correções), em dólares.
KORDA_ORCAMENTO_EXECUCAO_USD=8.00
KORDA_MAX_TURNOS_CONSTRUCAO=40
KORDA_MAX_TURNOS_TENTATIVA=12
# Estimativa de custo a partir dos tokens (preço público do Opus 5.5). O gateway cobra em créditos.
KORDA_PRECO_ENTRADA_USD_MTOK=4.00
KORDA_PRECO_SAIDA_USD_MTOK=20.00
# Converte o custo em centavos de real. 6,00 é suposição da equipe, não cotação.
KORDA_TAXA_USD_BRL=6.00

# Exemplo de variáveis locais. Copie para .env (ignorado pelo Git) e preencha.
# Nunca commite valores reais.

# --- Harness do executor (services/execution/korda_execution/harness) ---
# Corretor usado quando um teste protegido falha: roteirizado (padrão, sem LLM),
# falso (testes, sem LLM) ou agente (Claude Agent SDK, gasta créditos).
KORDA_CORRETOR=roteirizado
# O agente só roda com KORDA_PERMITIR_LLM_REAL=1, autorizado pelo responsável pela chave.
KORDA_PERMITIR_LLM_REAL=
# Chave fornecida pelo responsável; nunca commitar. Fica no host, nunca entra na sandbox.
ANTHROPIC_API_KEY=
KORDA_MODELO=claude-opus-5-5
# Teto de gasto com LLM por execução (soma das até 3 tentativas), em dólares.
KORDA_ORCAMENTO_EXECUCAO_USD=3.00
KORDA_MAX_TURNOS_TENTATIVA=12
# Converte o custo em centavos de real. 6,00 é suposição da equipe, não cotação.
KORDA_TAXA_USD_BRL=6.00

# Exemplo de variáveis locais. Copie para .env (ignorado pelo Git) e preencha.
# Nunca commite valores reais. Vazio usa o padrão indicado no comentário.

# --- Harness do executor (services/execution/korda_execution/harness) ---
# Quem constrói o pipeline a partir do plano: roteirizado (padrão, plano B: copia o pipeline
# feito à mão, sem LLM), falso (só testes, sem LLM), chat (agente sobre API chat/completions,
# ex.: gateway da Feita) ou agente_sdk (Claude Agent SDK; guardado, o worker o recusa).
# O worker lê esta variável antes de criar a sandbox. Com chat, `executar` exige --contexto.
KORDA_EXECUTOR=
# chat e agente_sdk só rodam com KORDA_PERMITIR_LLM_REAL=1, autorizado pelo responsável pela chave.
KORDA_PERMITIR_LLM_REAL=
# Chave do gateway chat/completions (Feita). Nunca commitar; fica no host, nunca entra na sandbox.
KORDA_LLM_CHAVE=
# Padrão: https://api.feita.ai/gateway/v1 (só https).
KORDA_LLM_URL=
# Chave da Anthropic, só para KORDA_EXECUTOR=agente_sdk (fora da demo; o worker não o usa).
ANTHROPIC_API_KEY=
# Padrão: anthropic/claude-opus-5.5 (chat) ou claude-opus-5-5 (agente_sdk).
KORDA_MODELO=
# Teto de gasto com LLM por execução (documento-base + construção + até 3 correções), em dólares. Padrão: 8.00.
KORDA_ORCAMENTO_EXECUCAO_USD=
# Padrões: 40 turnos na construção e 12 em cada correção.
KORDA_MAX_TURNOS_CONSTRUCAO=
KORDA_MAX_TURNOS_TENTATIVA=
# Estimativa de custo a partir dos tokens. Padrões: 4.00 e 20.00 (preço público do Opus 5.5).
# O gateway cobra em créditos.
KORDA_PRECO_ENTRADA_USD_MTOK=
KORDA_PRECO_SAIDA_USD_MTOK=
# Converte o custo em centavos de real. Padrão 6.00: suposição da equipe, não cotação.
KORDA_TAXA_USD_BRL=

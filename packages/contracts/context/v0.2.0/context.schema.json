{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "topic": {
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "goal",
            "process",
            "source",
            "rule",
            "constraint",
            "decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "time_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Scope"
        },
        "state": {
          "default": "declarada",
          "enum": [
            "declarada",
            "confirmada",
            "em_conflito",
            "substituida"
          ],
          "title": "State",
          "type": "string"
        },
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "confirmation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confirmation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "superseded_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Superseded By"
        },
        "source_verification": {
          "anyOf": [
            {
              "const": "nao_inspecionada",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Verification"
        },
        "inspected": {
          "const": false,
          "default": false,
          "title": "Inspected",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "topic",
        "key",
        "kind",
        "statement",
        "value",
        "critical",
        "evidence_ids"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Confirmation": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "participant_id": {
          "minLength": 1,
          "title": "Participant Id",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "participant_id",
        "role"
      ],
      "title": "Confirmation",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "topic": {
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "topic",
        "name",
        "kind",
        "evidence_ids"
      ],
      "title": "Entity",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "input_id": {
          "minLength": 1,
          "title": "Input Id",
          "type": "string"
        },
        "participant_id": {
          "minLength": 1,
          "title": "Participant Id",
          "type": "string"
        },
        "participant_role": {
          "minLength": 1,
          "title": "Participant Role",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "audio_transcript"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "input_timestamp": {
          "format": "date-time",
          "title": "Input Timestamp",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "start_offset": {
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        },
        "end_offset": {
          "exclusiveMinimum": 0,
          "title": "End Offset",
          "type": "integer"
        },
        "transcription_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcription Version"
        }
      },
      "required": [
        "id",
        "input_id",
        "participant_id",
        "participant_role",
        "kind",
        "source_id",
        "input_timestamp",
        "quote",
        "start_offset",
        "end_offset"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "topic": {
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "blocking": {
          "default": true,
          "title": "Blocking",
          "type": "boolean"
        },
        "state": {
          "default": "aberta",
          "enum": [
            "aberta",
            "a_confirmar",
            "respondida",
            "em_conflito"
          ],
          "title": "State",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "topic",
        "key",
        "question"
      ],
      "title": "Gap",
      "type": "object"
    },
    "JsonValue": {},
    "Relation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "topic": {
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "topic",
        "source_id",
        "target_id",
        "kind",
        "evidence_ids"
      ],
      "title": "Relation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "interview_status": {
      "default": "ativa",
      "enum": [
        "ativa",
        "pausada",
        "encerrada"
      ],
      "title": "Interview Status",
      "type": "string"
    },
    "state": {
      "default": "rascunho",
      "enum": [
        "rascunho",
        "pronto"
      ],
      "title": "State",
      "type": "string"
    },
    "required_topics": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Required Topics",
      "type": "object"
    },
    "processed_input_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Processed Input Ids",
      "type": "array"
    },
    "pending_input_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Pending Input Ids",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/Entity"
      },
      "title": "Entities",
      "type": "array"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/Relation"
      },
      "title": "Relations",
      "type": "array"
    },
    "gaps": {
      "items": {
        "$ref": "#/$defs/Gap"
      },
      "title": "Gaps",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "created_at",
    "synthetic",
    "interview_status",
    "state",
    "required_topics",
    "processed_input_ids",
    "pending_input_ids",
    "evidence",
    "claims",
    "entities",
    "relations",
    "gaps"
  ],
  "title": "Korda contexto de entrevista sintética v0.2.0",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://korda.local/contracts/context/0.2.0"
}

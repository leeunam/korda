  "gaps": [
    {
      "id": "lac-erp-atualizacao",
      "source_id": "erp",
      "question": "O ERP tem coluna de data de atualização ou log de alterações nos pedidos? Sem isso, a ingestão faz snapshot completo diário.",
      "blocking": false,
      "state": "aberta",
      "responsible_role": "dados"
    },
    {
      "id": "lac-tms-frequencia",
      "source_id": "tms",
      "question": "Com que atraso o indicador pode refletir a operação (latência aceitável) e em que horário o TMS fecha o dia?",
      "blocking": false,
      "state": "aberta",
      "responsible_role": "operacao"
    },
    {
      "id": "lac-cte-entrega",
      "source_id": "cte",
      "question": "Os XML de CT-e chegam todos os dias na pasta de entrega? Eventos de cancelamento chegam na mesma pasta?",
      "blocking": false,
      "state": "aberta",
      "responsible_role": "financeiro"
    },
    {
      "id": "lac-tms-viagens-trf",
      "source_id": "tms",
      "question": "O TMS tem viagens de transferência (TRF) que não apareceram na entrevista. A ingestão as traz como estão; elas entram nos indicadores?",
      "blocking": false,
      "state": "aberta",
      "responsible_role": "operacao"
    }
  ],
  "acceptance_tests": [
    {
      "id": "at-completude",
      "kind": "completude",
      "source_ids": [
        "erp",
        "tms",
        "cte"
      ],
      "criterion": "Contagens por objeto na landing iguais às servidas pelo sistema no dia corrente; CT-e por arquivo, inclusive duplicatas e eventos."
    },
    {
      "id": "at-idempotencia",
      "kind": "idempotencia",
      "source_ids": [
        "erp",
        "tms",
        "cte"
      ],
      "criterion": "Rodar de novo sem dado novo não altera nenhuma tabela da landing."
    },
    {
      "id": "at-incremental",
      "kind": "incremental",
      "source_ids": [
        "tms",
        "cte"
      ],
      "criterion": "Depois que chega o dia N+1, a nova carga traz só os registros e arquivos do dia novo."
    },
    {
      "id": "at-resiliencia",
      "kind": "resiliencia",
      "source_ids": [
        "erp",
        "tms"
      ],
      "criterion": "Falhas 429, 500 e tempo esgotado são superadas com novas tentativas dentro do limite; esgotado o limite, a execução falha sem gravar carga parcial."
    },
    {
      "id": "at-mudanca-esquema",
      "kind": "mudanca_esquema",
      "source_ids": [
        "erp",
        "tms"
      ],
      "criterion": "Coluna renomeada, nova ou ausente interrompe a carga e gera escalonamento ao humano; nada é gravado nem corrigido em silêncio."
    }
  ],
  "limits": {
    "max_correction_attempts": 3
  }
